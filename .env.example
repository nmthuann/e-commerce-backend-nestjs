# App
NODE_ENV=development
NESTJS_SERVER_PORT=3000
PUBLIC_API_FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecommerce
DB_LOGGING=false

# JWT (giá trị thời hạn tính bằng giây)
JWT_SECRET_KEY=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=900
REFRESH_JWT_SECRET_KEY=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=604800

# Tài khoản ADMIN đầu tiên do `yarn seed` tạo (chỉ tạo khi email chưa tồn tại)
SEED_ADMIN_EMAIL=admin@store.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_NAME=Administrator

# Stripe (test mode)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
